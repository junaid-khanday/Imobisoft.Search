@model ImobisoftSearchPageViewModel
@{
    SearchResponse? response = Model.Response;
}
@* One result per list item. Rendered both by the page and by "load more", so appended results can
   never differ from the first page's. *@
@if (response is not null)
{
    foreach (SearchResultItem item in response.Results)
    {
        <li>
            @if (!string.IsNullOrWhiteSpace(item.Url))
            {
                <a href="@item.Url">@item.Name</a>
            }
            else
            {
                <span>@item.Name</span>
            }

            <span>(@item.ContentTypeAlias)</span>

            @if (item.IsBestBet)
            {
                <span>[pinned]</span>
            }

            @if (!string.IsNullOrWhiteSpace(item.Highlight))
            {
                @* The package HTML-encodes this and leaves only the configured highlight tag, so it
                   is safe to render as markup. *@
                <p>@Html.Raw(item.Highlight)</p>
            }
        </li>
    }
}
