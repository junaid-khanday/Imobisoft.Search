@model ImobisoftSearchPageViewModel
@{
    Layout = null;
}
@*
    The package's own search page, served at /imobisoft-search so a site has working search the
    moment the package is installed.

    Everything below the page chrome is Views/Partials/Search/listing.cshtml - the very same block
    the embeddable view component renders. That is deliberate: this page used to carry its own copy
    of the filter bar and result cards, which is how the two drifted apart. With one copy, the
    profile's theme, its filters and its result markup are identical wherever search appears.

    To make this page look like the site, create Views/ImobisoftSearch/Index.cshtml in the project -
    a view of that name in the site wins over this one, and nothing else has to change.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(Model.HasSearched && !string.IsNullOrWhiteSpace(Model.Term) ? $"{Model.Term} - Search" : "Search")</title>
    <style>
        /* Page chrome only. Everything inside the listing is styled by the theme's own stylesheet
           (Views/Partials/Search/styles.cshtml), scoped under .isl. */
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            line-height: 1.5;
            padding: 32px 20px;
        }

        .imobisoft-container {
            max-width: 1100px;
            margin: 0 auto;
        }

        .imobisoft-header {
            margin-bottom: 20px;
        }

        .imobisoft-header h1 {
            font-size: 26px;
            font-weight: 700;
            color: #1b264f;
        }
    </style>
</head>
<body>
    <div class="imobisoft-container">
        <header class="imobisoft-header">
            <h1>Search</h1>
        </header>

        <partial name="~/Views/Partials/Search/listing.cshtml" model="Model" />
    </div>
</body>
</html>
