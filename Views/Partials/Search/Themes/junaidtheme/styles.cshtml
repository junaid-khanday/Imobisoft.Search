@*
    junaidtheme stylesheet - a two-tone blue and black skin.

    It replaces the package stylesheet outright, so every isl- class the listing and the fallback
    partials emit is styled here as well as this theme's own ibb- search bar. The filter bar sits
    above the search box because that is the order the listing renders them in; this only styles it.
*@
<style>
    .isl {
        /* Two tones and nothing else: near-black for structure and text, blue for anything
           interactive or emphasised. */
        --jt-black: #0b0f19;
        --jt-black-soft: #1b2233;
        --jt-blue: #2563eb;
        --jt-blue-dark: #1d4ed8;
        --jt-blue-tint: #eff4ff;
        --jt-line: #d7dEEA;
        --jt-muted: #5b6577;
        --jt-radius: 10px;

        font-size: 15px;
        line-height: 1.5;
        color: var(--jt-black);
    }

    .isl *,
    .isl *::before,
    .isl *::after { box-sizing: border-box; }

    /* ---------- Filter bar: above the search box ---------- */

    /* No panel and no heading: just the dropdowns, flat on whatever the page background is, so
       they are the only thing carrying a surface. */
    .isl-filter-bar {
        display: block;
        background: transparent;
        border: 0;
        padding: 0;
        margin-bottom: 16px;
    }

    /* The dropdowns themselves, wrapping onto a second row on narrow screens. */
    .jt-filter-controls {
        display: flex;
        gap: 14px;
        align-items: flex-end;
        flex-wrap: wrap;
    }

    .isl-filter-item { display: flex; flex-direction: column; gap: 6px; }

    .isl-filter-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--jt-black);
    }

    .isl-select {
        min-width: 190px;
        height: 40px;
        padding: 0 12px;
        font-size: 14px;
        color: var(--jt-black);
        background: #fff;
        border: 1.5px solid var(--jt-line);
        border-radius: 8px;
        outline: none;
        cursor: pointer;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

    .isl-select:hover { border-color: var(--jt-black-soft); }

    .isl-select:focus {
        border-color: var(--jt-blue);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .18);
    }

    .isl-clear-filters {
        display: inline-flex;
        align-items: center;
        height: 40px;
        padding: 0 12px;
        font-size: 12.5px;
        font-weight: 700;
        color: var(--jt-blue);
        text-decoration: none;
        border-radius: 8px;
        transition: background .12s ease;
    }

    .isl-clear-filters:hover { background: var(--jt-blue-tint); }

    /* Reset control, last in the row and matched to the dropdown height so it aligns with them
       rather than with their labels. Solid black against the blue search button, so the two read
       as different kinds of action rather than competing for the same one. */
    .jt-reset-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 40px;
        padding: 0 18px;
        border: 1.5px solid var(--jt-black);
        border-radius: 8px;
        background: var(--jt-black);
        color: #fff;
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: .02em;
        white-space: nowrap;
        text-decoration: none;
        cursor: pointer;
        box-shadow: 0 1px 2px rgba(11, 15, 25, .16);
        transition: background .15s ease, border-color .15s ease, box-shadow .15s ease, transform .1s ease;
    }

    .jt-reset-btn:hover {
        background: var(--jt-blue);
        border-color: var(--jt-blue);
        box-shadow: 0 4px 12px rgba(37, 99, 235, .3);
    }

    /* Pressed sits back down, so the click registers even where the colour barely shifts. */
    .jt-reset-btn:active {
        transform: translateY(1px);
        box-shadow: 0 1px 2px rgba(11, 15, 25, .2);
    }

    .jt-reset-btn:focus-visible {
        outline: 3px solid rgba(37, 99, 235, .45);
        outline-offset: 2px;
    }

    /* The arrow sweeps round on hover - the one bit of motion in the strip, so it reads as
       "undo" rather than as another filter. */
    .jt-reset-icon {
        flex: 0 0 auto;
        transition: transform .35s ease;
    }

    .jt-reset-btn:hover .jt-reset-icon { transform: rotate(-180deg); }

    /* ---------- Search bar: button inside, on the left ---------- */

    .ibb-form { margin-bottom: 22px; }

    /* The field owns the border and the rounding; the button and input sit flush inside it, so
       the blue block reads as part of the bar rather than a separate control beside it. */
    .ibb-field {
        display: flex;
        align-items: stretch;
        overflow: hidden;
        background: #fff;
        border: 2px solid var(--jt-black);
        border-radius: var(--jt-radius);
        transition: border-color .15s ease, box-shadow .15s ease;
    }

    .ibb-field:focus-within {
        border-color: var(--jt-blue);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, .16);
    }

    .ibb-btn {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 54px;
        border: 0;
        background: var(--jt-blue);
        color: #fff;
        cursor: pointer;
        transition: background .15s ease;
    }

    .ibb-btn:hover { background: var(--jt-blue-dark); }

    .ibb-btn:active { background: var(--jt-black); }

    .ibb-input {
        flex: 1 1 auto;
        min-width: 0;
        height: 52px;
        padding: 0 16px;
        font-size: 15px;
        color: var(--jt-black);
        background: transparent;
        border: 0;
        outline: none;
    }

    .ibb-input::placeholder { color: #93a0b5; }

    /* ---------- Banners and stats ---------- */

    .isl-suggestion {
        background: var(--jt-blue-tint);
        border: 1px solid #c3d4fb;
        border-left: 4px solid var(--jt-blue);
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 16px;
        font-size: 14px;
        color: var(--jt-black);
    }

    .isl-suggestion a { color: var(--jt-blue-dark); font-weight: 700; }

    .isl-stats {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        padding-bottom: 12px;
        margin-bottom: 18px;
        border-bottom: 2px solid var(--jt-black);
        font-size: 13.5px;
        color: var(--jt-muted);
    }

    .isl-stats strong { color: var(--jt-black); }

    .isl-groups { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }

    .isl-group-pill {
        background: #fff;
        border: 1px solid var(--jt-line);
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 12px;
        color: var(--jt-muted);
    }

    .isl-group-pill strong { color: var(--jt-blue); }

    /* ---------- Results ---------- */

    .isl-results {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    /* A numbered rail down the left, then the body - the shape this theme's own results.cshtml
       emits, rather than the package default's badge-row-then-title card. */
    .isl-card {
        display: flex;
        align-items: stretch;
        gap: 16px;
        background: #fff;
        border: 1px solid var(--jt-line);
        border-radius: var(--jt-radius);
        padding: 16px 20px 16px 16px;
        transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
    }

    .isl-card:hover {
        border-color: var(--jt-blue);
        box-shadow: 0 6px 18px rgba(11, 15, 25, .08);
        transform: translateX(2px);
    }

    .isl-card.is-bestbet {
        border-color: var(--jt-blue);
        background: linear-gradient(90deg, var(--jt-blue-tint), #fff 40%);
    }

    .jt-card-rail {
        flex: 0 0 auto;
        display: flex;
        align-items: flex-start;
    }

    .jt-card-index {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
        height: 30px;
        padding: 0 6px;
        border-radius: 8px;
        background: var(--jt-black);
        color: #fff;
        font-size: 12px;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
    }

    .isl-card:hover .jt-card-index { background: var(--jt-blue); }

    .jt-card-body { flex: 1 1 auto; min-width: 0; }

    .jt-card-url {
        display: block;
        font-size: 12px;
        color: var(--jt-blue);
        margin-bottom: 8px;
        word-break: break-all;
    }

    .jt-meta-text { color: #7b8698; }

    .isl-card-header { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }

    .isl-badge {
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        padding: 3px 9px;
        border-radius: 999px;
        display: inline-block;
        background: var(--jt-black);
        color: #fff;
    }

    .isl-badge-bestbet { background: var(--jt-blue); color: #fff; }

    .isl-title { font-size: 17px; font-weight: 700; margin: 0 0 6px; line-height: 1.35; }

    .isl-title a { color: var(--jt-black); text-decoration: none; }

    .isl-title a:hover { color: var(--jt-blue); text-decoration: underline; }

    .isl-snippet { font-size: 13.5px; color: var(--jt-muted); margin: 0 0 10px; line-height: 1.6; }

    .isl-snippet mark {
        background: var(--jt-blue-tint);
        color: var(--jt-blue-dark);
        font-weight: 700;
        padding: 0 3px;
        border-radius: 3px;
    }

    .isl-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        padding-top: 10px;
        border-top: 1px solid var(--jt-line);
        font-size: 11.5px;
        color: #7b8698;
    }

    .isl-meta-url { color: var(--jt-blue); word-break: break-all; }

    /* ---------- Empty states ---------- */

    .isl-empty {
        background: #fff;
        border: 1px dashed var(--jt-line);
        border-radius: var(--jt-radius);
        padding: 48px 24px;
        text-align: center;
        color: var(--jt-muted);
    }

    .isl-empty h3 { margin: 0 0 8px; color: var(--jt-black); font-size: 18px; }

    .isl-empty a { color: var(--jt-blue); font-weight: 700; }

    /* ---------- Load more ---------- */

    .isl-loadmore { display: flex; justify-content: center; margin-top: 24px; }

    .isl-btn-more {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        max-width: 340px;
        height: 48px;
        padding: 0 22px;
        background: var(--jt-black);
        border: 2px solid var(--jt-black);
        border-radius: var(--jt-radius);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: background .15s ease, border-color .15s ease, color .15s ease;
    }

    .isl-btn-more:hover:not(:disabled) {
        background: var(--jt-blue);
        border-color: var(--jt-blue);
    }

    .isl-btn-more:disabled { opacity: .55; cursor: wait; }

    .isl-btn-more-count {
        font-size: 11.5px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 999px;
        background: rgba(255, 255, 255, .16);
    }

    .isl-profile { font-size: 11px; color: #7b8698; }

    @@media (max-width: 44rem) {
        .isl-select { min-width: 100%; }
        .isl-filter-item { width: 100%; }
        .isl-btn-more { max-width: 100%; }
    }
</style>
