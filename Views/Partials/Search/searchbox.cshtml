@using Imobisoft.Search.Models
@model SearchBoxModel
@{
    // The button needs something to point aria-controls at, and a page may hold more than one box.
    var inputId = string.IsNullOrWhiteSpace(Model.Id)
        ? "isb-" + Guid.NewGuid().ToString("N")[..8]
        : Model.Id;
    var formId = inputId + "-form";
    var open = Model.StartOpen || !string.IsNullOrWhiteSpace(Model.Term);
    var grow = Model.OpenToTheLeft ? "left" : "right";
}
@* The header search box. Closed, it is just a button - clicking it opens the search bar on the page
   the visitor is already on, and nothing navigates. Clicking the button again, with a term typed,
   submits and lands on the results page.

   A consuming site can take over this exact spot by creating its own file at
   Views/Partials/Search/searchbox.cshtml - the site's file wins over this one automatically, with no
   configuration. The only contract: a GET form containing a text input named "q", and a submit
   button for it. Keep the data-* hooks to keep the open/close behaviour. *@
<div class="isb @Model.RootClass"
     style="--isb-open-width: @Model.OpenWidth; --isb-icon-size: @(Model.IconSize)px"
     data-imobisoft-searchbox
     data-isb-grow="@grow"
     data-open="@(open ? "true" : "false")">
    <style>
        .isb {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            vertical-align: middle;
        }

        .isb[data-isb-grow="right"] { flex-direction: row-reverse; }

        .isb *,
        .isb *::before,
        .isb *::after { box-sizing: border-box; }

        .isb-form { display: flex; margin: 0; }

        /* Closed, the input is zero-width and out of the tab order; opening it is a width change,
           so the bar slides out of the button rather than appearing from nowhere. */
        .isb-input {
            width: 0;
            height: 40px;
            padding: 0;
            font: inherit;
            font-size: 15px;
            color: #1e293b;
            background: #fff;
            border: 1px solid transparent;
            border-radius: 999px;
            outline: none;
            opacity: 0;
            visibility: hidden;
            transition: width .22s ease, padding .22s ease, opacity .18s ease, visibility .22s;
        }

        .isb[data-open="true"] .isb-input {
            width: var(--isb-open-width, 260px);
            padding: 0 16px;
            border-color: #cbd5e1;
            opacity: 1;
            visibility: visible;
        }

        .isb-input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, .15);
        }

        /* Transparent and colour-inheriting, so the button takes on whatever header it is dropped
           into without the site styling it. */
        .isb-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            height: 40px;
            min-width: 40px;
            padding: 0 11px;
            font: inherit;
            font-size: 14px;
            font-weight: 600;
            color: inherit;
            background: transparent;
            border: 0;
            border-radius: 999px;
            cursor: pointer;
            transition: background .15s ease;
        }

        .isb-btn:hover { background: rgba(15, 23, 42, .07); }

        .isb-btn:focus-visible { outline: 2px solid #3b82f6; outline-offset: 2px; }

        .isb-icon {
            width: var(--isb-icon-size, 18px);
            height: var(--isb-icon-size, 18px);
            flex: 0 0 auto;
            display: block;
            object-fit: contain;
        }

        /* Narrow screens have no room beside the button, so the bar drops underneath it instead. */
        @@media (max-width: 560px) {
            .isb[data-open="true"] .isb-form {
                position: absolute;
                top: calc(100% + 10px);
                right: 0;
                z-index: 60;
                padding: 8px;
                background: #fff;
                border-radius: 12px;
                box-shadow: 0 10px 25px rgba(15, 23, 42, .18);
            }

            .isb[data-isb-grow="right"][data-open="true"] .isb-form {
                right: auto;
                left: 0;
            }

            .isb[data-open="true"] .isb-input { width: min(72vw, 320px); }
        }

        @@media (prefers-reduced-motion: reduce) {
            .isb-input { transition: none; }
        }
    </style>

    @* The form holds the input only. The button submits it from outside via its form attribute,
       which is what keeps the button sitting still in the header while the bar moves and, on small
       screens, drops into a panel of its own. *@
    <form id="@formId"
          class="isb-form @Model.FormClass"
          role="search"
          method="get"
          action="@Model.Action"
          data-isb-form>
        <input type="search"
               id="@inputId"
               name="@Model.QueryName"
               class="isb-input @Model.InputClass"
               value="@Model.Term"
               placeholder="@Model.Placeholder"
               autocomplete="off"
               aria-label="@Model.ButtonLabel"
               data-isb-input />
    </form>

    <button type="submit"
            form="@formId"
            class="isb-btn @Model.ButtonClass"
            title="@Model.ButtonLabel"
            aria-label="@Model.ButtonLabel"
            aria-expanded="@(open ? "true" : "false")"
            aria-controls="@inputId"
            data-isb-btn>
        @* A site's own file is rendered as an image, so it keeps its own colours; the inline
           magnifier is the default and takes the colour of the button it sits on. *@
        @if (!string.IsNullOrWhiteSpace(Model.IconUrl))
        {
            <img class="isb-icon" src="@Model.IconUrl" alt="" aria-hidden="true"
                 width="@Model.IconSize" height="@Model.IconSize" />
        }
        else
        {
            <svg class="isb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" aria-hidden="true" focusable="false">
                <circle cx="11" cy="11" r="7" />
                <line x1="16.5" y1="16.5" x2="21" y2="21" />
            </svg>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ButtonText))
        {
            <span class="isb-btn-text">@Model.ButtonText</span>
        }
    </button>

    @* Without JavaScript nothing can open the bar, so leave it open: the button then behaves the way
       it did before - one press, straight to the results page. *@
    <noscript>
        <style>
            .isb .isb-input {
                width: var(--isb-open-width, 260px);
                padding: 0 16px;
                border-color: #cbd5e1;
                opacity: 1;
                visibility: visible;
            }
        </style>
    </noscript>
</div>

<script>
    (function () {
        document.querySelectorAll('[data-imobisoft-searchbox]').forEach(function (root) {
            if (root.dataset.isbBound) return;
            root.dataset.isbBound = 'true';

            var form = root.querySelector('[data-isb-form]');
            var input = root.querySelector('[data-isb-input]');
            var btn = root.querySelector('[data-isb-btn]');
            if (!form || !input || !btn) return;

            function isOpen() {
                return root.getAttribute('data-open') === 'true';
            }

            function setOpen(open) {
                root.setAttribute('data-open', open ? 'true' : 'false');
                btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            }

            btn.addEventListener('click', function (e) {
                // First press only opens the bar: the visitor stays on the page they are on.
                if (!isOpen()) {
                    e.preventDefault();
                    setOpen(true);
                    input.focus();
                    return;
                }

                // Open with nothing typed - a second press is a dismiss, not a search for "".
                if (!input.value.trim()) {
                    e.preventDefault();
                    setOpen(false);
                    return;
                }

                // Open with a term: let the form submit and take the visitor to the results page.
            });

            // Enter inside the box is the same submit, so guard the empty case there too.
            form.addEventListener('submit', function (e) {
                if (!input.value.trim()) {
                    e.preventDefault();
                    input.focus();
                }
            });

            input.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' || e.key === 'Esc') {
                    setOpen(false);
                    btn.focus();
                }
            });

            // An empty bar left open is just clutter, so clicking away closes it. A typed term is
            // kept, in case the click was somewhere harmless.
            document.addEventListener('click', function (e) {
                if (!isOpen() || root.contains(e.target) || input.value.trim()) return;
                setOpen(false);
            });
        });
    })();
</script>
