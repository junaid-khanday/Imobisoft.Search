@model Imobisoft.Search.Web.ImobisoftSearchListingViewModel
@* Shown instead of the result list when the current page holds no items. Override at
   Views/Partials/Search/noresults.cshtml to restyle both states:
   - TotalResults == 0: genuinely nothing matched.
   - TotalResults > 0 with an empty page: matches exist elsewhere (paging or the profile's
     "results before searching" limit). *@
@{
    Imobisoft.Search.Models.SearchResponse? response = Model.Response;
    var hasActiveFilters = Context.HasActiveFilters();
}
@if (response!.Results.Count == 0 && response.TotalResults == 0)
{
    <div class="isl-empty">
        <h3>No results matched your search</h3>
        <p>Try searching with different keywords, checking your spelling, or clearing active filters.</p>
        @if (hasActiveFilters)
        {
            <p style="margin-top: 14px;">
                <a href="@Context.ClearFiltersUrl()" rel="nofollow">Clear active filters</a>
            </p>
        }
    </div>
}
else if (response.Results.Count == 0)
{
    <div class="isl-empty">
        <h3>Nothing to show on this page</h3>
        <p>@response.TotalResults result@(response.TotalResults == 1 ? " matches" : " matches") were found.
           Use the page controls above, or ask your editor to raise the profile's page limits in the Search section.</p>
    </div>
}
