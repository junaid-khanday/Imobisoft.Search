@model Imobisoft.Search.Web.ImobisoftSearchListingViewModel
@* Shown instead of the result list when nothing matched. Override at
   Views/Partials/Search/noresults.cshtml, or per theme at
   Views/Partials/Search/Themes/<name>/noresults.cshtml, to restyle it.

   A page that holds no items while matches exist elsewhere (paging, or the profile's "results
   before searching" limit) renders nothing at all rather than explaining itself - the visitor is
   not the one who can act on it. *@
@{
    Imobisoft.Search.Models.SearchResponse? response = Model.Response;
    var hasActiveFilters = Context.HasActiveFilters();
}
@if (response!.Results.Count == 0 && response.TotalResults == 0)
{
    <div class="isl-empty">
        <h3>No results matched your search</h3>
        <p>Try searching with different keywords, checking your spelling, or clearing active filters.</p>
        @if (hasActiveFilters)
        {
            <p style="margin-top: 14px;">
                <a href="@Context.ClearFiltersUrl()" rel="nofollow">Clear active filters</a>
            </p>
        }
    </div>
}
